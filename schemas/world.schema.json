{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hakoniwa FPV MuJoCo World",
  "type": "object",
  "required": ["schema_version", "visual", "ground", "obstacles"],
  "properties": {
    "schema_version": {"const": 1},
    "visual": {"type": "object"},
    "ground": {"type": "object"},
    "contact": {
      "type": "object",
      "properties": {
        "ground_friction": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}},
        "vehicle_friction": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}},
        "obstacle_friction": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}},
        "obstacle_condim": {"enum": [1, 3, 4, 6]}
      }
    },
    "lights": {"type": "array"},
    "obstacles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type", "center_m"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "type": {"enum": ["box", "pylon", "gate"]},
          "center_m": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
          "yaw_deg": {"type": "number"},
          "rgba": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
        }
      }
    }
  }
}
