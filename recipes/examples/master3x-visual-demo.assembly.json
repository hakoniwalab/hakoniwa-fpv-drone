        "port": "propeller_shaft"
      },
      "consumer": {
        "node": "propeller_2",
        "port": "motor_shaft"
      }
    },
    {
      "provider": {
        "node": "frame",
        "port": "motor_mount_3"
      },
      "consumer": {
        "node": "motor_3",
        "port": "frame_mount"
      }
